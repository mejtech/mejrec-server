{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ns",
	"main": "src/ns.app.ts",
	"compatibility_date": "2026-06-16",
	"compatibility_flags": ["nodejs_compat"],
	"logpush": false,
	"upload_source_maps": true,
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1 // 100%
		}
	},
	"vars": {
		"ENVIRONMENT": "development", // overridden during deployment
		"SENTRY_RELEASE": "unknown", // overridden during deployment
		// Local play: every *.rec.localhost name resolves to 127.0.0.1, so the endpoints
		// document is reachable without editing /etc/hosts. The :8443 is the local TLS
		// proxy (see local/README.md). Deploy always overrides both vars from
		// RECFLARE_DOMAIN / RECFLARE_SUBDOMAINS, so this default only affects `just dev`.
		"DOMAIN": "rec.localhost:8443", // base domain; overridden during deployment
		"SUBDOMAINS": "{\"moderation\":\"api\"}" // per-service subdomain overrides; overridden during deployment
	}
}
